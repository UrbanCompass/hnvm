#!/usr/bin/env bash

set -e

node_bin=

# The exposed bin files are symlinked into the user's $PATH, so we need to make our way back to
# the original path location to understand where the rest of this package's files are installed
source="${BASH_SOURCE[0]}"
while [ -h "$source" ]; do # resolve $source until the file is no longer a symlink
  script_dir="$( cd -P "$( dirname "$source" )" >/dev/null 2>&1 && pwd )"
  source="$(readlink "$source")"
  [[ $source != /* ]] && source="$script_dir/$source"
done
script_dir="$( cd -P "$( dirname "$source" )" >/dev/null 2>&1 && pwd )"

# Transition (Go rewrite): run the Go binary when asked to. Removed once every tool is ported.
if [[ -n "${HNVM_GO_BIN:-}" ]]; then
  # shellcheck source=/dev/null
  source "$script_dir/../lib/hnvm/bootstrap.sh"
  hnvm_bootstrap_exec "$script_dir" "$(basename "$0")" "$@"
fi

# shellcheck source=/dev/null
source "$script_dir/../lib/hnvm/ensure_bin.sh"

exec "${node_bin}" "$@"
